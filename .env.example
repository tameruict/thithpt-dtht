NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only Cloudflare R2 settings. Never prefix these with NEXT_PUBLIC_.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Server-only Supabase key used by maintenance scripts. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Server-only checkout configuration used by Next.js.
PAYMENT_PROVIDER=thueapibank
PAYMENT_BANK_CODE=
PAYMENT_BANK_ACCOUNT=
PAYMENT_ACCOUNT_NAME=
THUEAPIBANK_POLL_SECRET=

# Set true only after staging/Test Mode verification.
KEY_PURCHASE_ENABLED=false

# Supabase Edge Function secrets (set with `supabase secrets set`; never expose
# these as NEXT_PUBLIC_*). The contract JSON is copied from the highest usable
# V1/V2/V3 contract after login and must not contain the API key itself.
THUEAPIBANK_API_KEY=
THUEAPIBANK_CONTRACT_JSON=
