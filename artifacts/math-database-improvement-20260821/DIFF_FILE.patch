+.page { max-width: 1180px; margin: 0 auto; padding: 36px 20px 72px; }
+.header { display: flex; justify-content: space-between; gap: 24px; align-items: end; }
+.header p, .summary { color: var(--muted); }
+.header h1 { margin: 4px 0 0; }
+.header a { color: var(--primary); font-weight: 700; }
+.summary { margin: 24px 0 14px; }
+.message { margin-bottom: 14px; padding: 12px; border: 1px solid var(--border); background: var(--surface-soft); }
+.list { display: grid; gap: 16px; }
+.card { padding: 18px; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--surface-elevated); }
+.meta { display: flex; flex-wrap: wrap; gap: 10px 16px; align-items: center; }
+.meta span { color: var(--muted); font-size: .86rem; }
+.meta span[data-severity="error"] { color: var(--danger, #b42318); font-weight: 700; }
+.compare { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 16px; }
+.compare pre { min-height: 96px; max-height: 260px; margin: 7px 0 0; padding: 12px; overflow: auto; border: 1px solid var(--border); background: var(--surface-soft); white-space: pre-wrap; }
+.actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 14px; }
+.actions button { display: inline-flex; gap: 7px; align-items: center; min-height: 40px; padding: 0 14px; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--surface-elevated); cursor: pointer; }
+.actions button:last-child { border-color: var(--primary); color: white; background: var(--primary); }
+.empty { padding: 48px; border: 1px dashed var(--border); color: var(--muted); text-align: center; }
+@media (max-width: 720px) { .header { align-items: flex-start; flex-direction: column; } .compare { grid-template-columns: 1fr; } }
+
