+create or replace function public.get_session_review(p_session_id uuid)
+ returns jsonb
+ language plpgsql
+ security definer
+ set search_path to ''
+as $function$
+declare
+  v_student uuid;
+  v_status text;
+  v_score numeric;
+  v_due timestamptz;
