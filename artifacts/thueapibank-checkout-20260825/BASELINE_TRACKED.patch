-                'code', qq.code,
-                'difficulty', qq.difficulty,
-                'content', left(qq.content, 240),
-                'seq', erq.seq
-              ) order by erq.seq
-            )
-            from public.exam_room_questions erq
-            join public.questions qq on qq.id = erq.question_id
-            where erq.paper_id = p_paper_id and erq.blueprint_section_id = s.id
