-create or replace function private.fn_exam_keys_sync_paper_room()
-returns trigger
-language plpgsql
-set search_path = ''
-as $$
-begin
-  new.exam_room_id := null;
-  new.paper_id := null;
-  return new;
-end;
-$$;
-
-comment on function private.fn_exam_keys_sync_paper_room() is
