-  subject_code := nullif(upper(trim(p_subject_code)), '');
-  requested_room_id := p_exam_room_id;
-
-  select
-    key.id,
-    key.assigned_to,
-    key.total_attempts,
-    key.used_attempts,
-    key.status,
-    key.expires_at
