# Server-only SePay webhook and receiving-account configuration.
SEPAY_WEBHOOK_API_KEY=
SEPAY_BANK_CODE=
SEPAY_BANK_ACCOUNT=
SEPAY_ACCOUNT_NAME=

# Set true only after staging/Test Mode verification.
KEY_PURCHASE_ENABLED=false
