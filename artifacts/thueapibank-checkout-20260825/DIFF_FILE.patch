+  provider: 'thueapibank';
+  providerEventId: string;
+  transactionAt: string;
+  direction: 'in' | 'out';
+  amount: number;
+  content: string;
+  accountNumber: string;
+  bankCode: string;
+  providerReference: string | null;
+  raw: unknown;
